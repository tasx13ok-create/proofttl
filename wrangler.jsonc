{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofttl",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "LEASES",
      "id": "41d241a2cd454097a2ab3ab9d8ffeb10"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "VERIFY_RATE_LIMITER",
      "namespace_id": "24081701",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "PROOFTTL_MAX_TTL_SECONDS": "604800",
    "PROOFTTL_MAX_SOURCE_CHARS": "30000"
  }
}
