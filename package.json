{
  "name": "proofttl",
  "version": "1.0.1",
  "private": true,
  "description": "Source-backed, expiring fact leases for machines.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run test:local",
    "deploy": "wrangler deploy",
    "postdeploy": "npm run test:smoke",
    "launch:testnet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-testnet.ps1",
    "tail": "wrangler tail",
    "monitor:d1:create": "wrangler d1 create proofttl-monitor --binding MONITOR_DB --update-config",
    "monitor:d1:migrate": "wrangler d1 migrations apply MONITOR_DB --remote",
    "auth:schema:generate": "auth generate --config ./scripts/auth-schema-config.js --output ./generated-auth-schema.sql --yes",
    "signing:key:generate": "node scripts/generate-signing-key.js",
    "audit:prepare": "node scripts/prepare-audit-worklist.js",
    "audit:run:testnet": "node --env-file=.env.test-payer scripts/run-audit-batch.js",
    "audit:report": "node scripts/generate-audit-report.js",
    "audit:sample:prepare": "node scripts/prepare-audit-worklist.js samples/perplexity-audit-candidates.json samples/perplexity-audit-worklist.json 604800",
    "audit:sample:preflight": "node --env-file=.env.test-payer scripts/run-audit-batch.js samples/perplexity-audit-worklist.json samples/perplexity-audit-leases.json",
    "audit:sample:report": "node scripts/generate-audit-report.js samples/perplexity-audit-leases.json samples/perplexity-audit-report.md",
    "dev:entitle": "node scripts/grant-dev-entitlement.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:security": "node scripts/security-test.js",
    "test:regression": "node scripts/regression-test.js",
    "test:limits": "node scripts/limits-test.js",
    "test:costs": "node scripts/costs-test.js",
    "test:economics": "node scripts/economics-test.js",
    "test:monitor-cost": "node scripts/monitor-cost-test.js",
    "test:lease-store": "node scripts/lease-store-test.js",
    "test:lease-signing": "node scripts/lease-signing-test.js",
    "test:claim-contract-ttl": "node scripts/claim-contract-ttl-test.js",
    "test:event-signing": "node scripts/event-signing-test.js",
    "test:audit-intake": "node scripts/audit-intake-test.js",
    "test:audit-sales": "node scripts/audit-sales-test.js",
    "test:stripe-payments": "node scripts/stripe-payments-test.js",
    "test:account-workspace": "node scripts/account-workspace-test.js",
    "test:studio-runner": "node scripts/studio-runner-test.js",
    "test:capabilities": "node scripts/capability-registry-test.js",
    "test:platform-spine": "node scripts/platform-spine-test.js",
    "test:release": "node scripts/release-v1-test.js",
    "test:http-cors": "node scripts/http-cors-test.js",
    "test:assistant-cors": "node scripts/assistant-cors-test.js",
    "test:assistant": "node scripts/assistant-test.js",
    "test:assistant-text": "node scripts/assistant-text-test.js",
    "test:assistant-speech": "node scripts/assistant-speech-test.js",
    "test:assistant-visuals": "node scripts/assistant-visuals-test.js",
    "test:assistant-quota": "node scripts/assistant-quota-test.js",
    "test:assistant-model-router": "node scripts/assistant-model-router-test.js",
    "test:entitlements": "node scripts/entitlements-test.js",
    "test:readiness": "node scripts/readiness-test.js",
    "test:auth": "node scripts/auth-test.js",
    "test:auth-schema": "npm run auth:schema:generate && node scripts/auth-schema-test.js",
    "test:model-fixtures": "node scripts/model-eval-fixtures-test.js",
    "test:model-routing": "node scripts/model-routing-test.js",
    "test:payment-gate": "node scripts/x402-gate-test.js",
    "test:cdp-auth": "node scripts/cdp-auth-test.js",
    "test:mira": "node scripts/mira-test.js",
    "test:foundry-research": "node scripts/foundry-research-test.js",
    "test:foundry": "node scripts/foundry-test.js",
    "test:local": "npm run test:security && npm run test:limits && npm run test:costs && npm run test:economics && npm run test:monitor-cost && npm run test:lease-store && npm run test:lease-signing && npm run test:claim-contract-ttl && npm run test:event-signing && npm run test:audit-intake && npm run test:audit-sales && npm run test:stripe-payments && npm run test:account-workspace && npm run test:studio-runner && npm run test:capabilities && npm run test:platform-spine && npm run test:http-cors && npm run test:assistant-cors && npm run test:assistant && npm run test:assistant-text && npm run test:assistant-speech && npm run test:assistant-visuals && npm run test:assistant-quota && npm run test:assistant-model-router && npm run test:entitlements && npm run test:readiness && npm run test:auth && npm run test:auth-schema && npm run test:model-fixtures && npm run test:model-routing && npm run test:payment-gate && npm run test:cdp-auth && npm run test:mira && npm run test:foundry-research && npm run test:foundry && npm run test:regression && npm run test:release",
    "test:all": "npm run test:local && npm run test:smoke",
    "economics": "node scripts/unit-economics.js",
    "eval:model": "node scripts/run-model-eval.js",
    "test:payer:create": "node scripts/create-test-payer.js",
    "test:payment": "node --env-file=.env.test-payer scripts/test-payment.js",
    "test:payment:semantic": "node --env-file=.env.test-payer scripts/test-payment-semantic.js"
  },
  "dependencies": {
    "@better-auth/core": "1.6.25",
    "@better-auth/passkey": "1.6.25",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/hono": "2.20.0",
    "better-auth": "1.6.25",
    "hono": "4.12.33",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "auth": "1.6.25",
    "wrangler": "^4.0.0"
  }
}