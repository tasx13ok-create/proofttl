{
  "name": "proofttl",
  "version": "0.3.1",
  "private": true,
  "description": "Source-backed, expiring fact leases for machines.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run test:all",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test:smoke": "node scripts/smoke-test.js",
    "test:security": "node scripts/security-test.js",
    "test:regression": "node scripts/regression-test.js",
    "test:limits": "node scripts/limits-test.js",
    "test:costs": "node scripts/costs-test.js",
    "test:economics": "node scripts/economics-test.js",
    "test:monitor-cost": "node scripts/monitor-cost-test.js",
    "test:model-fixtures": "node scripts/model-eval-fixtures-test.js",
    "test:model-launcher": "node scripts/model-eval-launcher-test.js",
    "test:all": "npm run test:security && npm run test:limits && npm run test:costs && npm run test:economics && npm run test:monitor-cost && npm run test:model-fixtures && npm run test:model-launcher && npm run test:regression && npm run test:smoke",
    "economics": "node scripts/unit-economics.js",
    "eval:model": "node scripts/run-model-eval.js",
    "test:payer:create": "node scripts/create-test-payer.js",
    "test:payment": "node --env-file=.env.test-payer scripts/test-payment.js"
  },
  "dependencies": {
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/hono": "2.20.0",
    "hono": "4.12.33",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
