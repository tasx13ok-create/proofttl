{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofTTL canonical MCP tool contracts",
  "version": "0.1.0-design",
  "status": "design-only",
  "source_policies": ["customer_only", "customer_plus_public", "public_only"],
  "verdicts": ["SUPPORTED", "CONTRADICTED", "MIXED", "UNKNOWN", "STALE", "SOURCE_CONFLICT"],
  "tools": {
    "audit_claim": {
      "input": {
        "type": "object",
        "required": ["claim", "sources", "source_policy"],
        "additionalProperties": false,
        "properties": {
          "claim": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source_policy": {"enum": ["customer_only", "customer_plus_public", "public_only"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"$ref": "#/$defs/source"}
          },
          "as_of": {"type": ["string", "null"], "format": "date-time"},
          "consequence": {"type": ["string", "null"], "enum": ["low", "medium", "high", "critical", null]}
        }
      }
    },
    "audit_output": {
      "input": {
        "type": "object",
        "required": ["output_text", "sources", "source_policy"],
        "additionalProperties": false,
        "properties": {
          "output_text": {"type": "string", "minLength": 1, "maxLength": 50000},
          "source_policy": {"enum": ["customer_only", "customer_plus_public", "public_only"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"$ref": "#/$defs/source"}
          },
          "max_claims": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25},
          "consequence_threshold": {"enum": ["low", "medium", "high", "critical"], "default": "medium"}
        }
      }
    },
    "create_fact_lease": {
      "input": {
        "type": "object",
        "required": ["audit_id", "claim_result_id", "ttl_seconds", "idempotency_key"],
        "additionalProperties": false,
        "properties": {
          "audit_id": {"type": "string", "minLength": 1},
          "claim_result_id": {"type": "string", "minLength": 1},
          "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 604800},
          "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200}
        }
      },
      "invariant": "Server must load authoritative audit result and reject non-lease-eligible verdicts. Host may not provide a verdict."
    },
    "get_fact_lease": {
      "input": {
        "type": "object",
        "required": ["lease_id"],
        "additionalProperties": false,
        "properties": {
          "lease_id": {"type": "string", "pattern": "^ftl_[a-zA-Z0-9_-]+$"}
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "origin"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["url", "text", "file"]},
        "origin": {"const": "customer"},
        "label": {"type": ["string", "null"], "maxLength": 300},
        "url": {"type": ["string", "null"], "format": "uri"},
        "text": {"type": ["string", "null"], "maxLength": 100000},
        "file_token": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}
